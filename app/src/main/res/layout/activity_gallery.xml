<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arch_bg"
    android:orientation="vertical"
    tools:context=".gallery.GalleryActivity">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/arch_surface"
        android:gravity="center_vertical"
        android:minHeight="@dimen/arch_top_bar_min_height"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/arch_padding_screen_h"
        android:paddingTop="@dimen/arch_padding_screen_v"
        android:paddingBottom="@dimen/arch_padding_screen_v">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="@dimen/arch_touch_min"
            android:layout_height="@dimen/arch_touch_min"
            android:contentDescription="@string/back"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="←"
            android:textColor="@color/arch_text"
            android:textSize="20sp"
            app:backgroundTint="@android:color/transparent"
            app:rippleColor="#33FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/gallery"
            android:textColor="@color/arch_text"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/arch_border" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_gallery"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="11dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/empty_gallery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:textColor="@color/arch_text"
            android:textSize="15sp"
            android:visibility="gone"
            tools:text="@string/gallery_empty"
            tools:visibility="visible" />
    </FrameLayout>
</LinearLayout>
