<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/camera_3a_name"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:textColor="@color/arch_muted"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/camera_3a_auto_manual"
        style="@style/Widget.ArchCamera.Button.CameraToggle"
        android:layout_width="44dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="@string/camera_3a_auto"
        android:textSize="11sp" />

    <SeekBar
        android:id="@+id/camera_3a_seek"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:paddingStart="0dp"
        android:paddingEnd="0dp" />

    <TextView
        android:id="@+id/camera_3a_value"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:textColor="@color/arch_text"
        android:textSize="11sp"
        android:textAlignment="viewEnd" />
</LinearLayout>
